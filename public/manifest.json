{
  "manifest_version": 3,
  "name": "NBA Live Box Scores",
  "version": "1.0.0",
  "description": "Live NBA box scores as a lightweight popup in your browser.",

  "action": {
    "default_popup": "index.html"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": ["storage"]
}